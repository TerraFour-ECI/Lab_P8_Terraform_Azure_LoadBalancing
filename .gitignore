# === Terraform ===
# Estado local y backups
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan
*.tfplan.*

# Variables sensibles
*.tfvars
*.tfvars.json
!env/dev.tfvars        # Mantener solo el ejemplo no sensible
!env/prod.tfvars.example

# Archivos de backend locales
backend.hcl
*.hcl.local

# Carpeta de caché local
.terraform/
# .terraform.lock.hcl  # incluido en el repo para fijar versiones de providers

# Logs y outputs
logs/
*.log
output.json
output.txt

# === Visual Studio Code / IDE ===
.vscode/
.idea/
*.iml

# === macOS / Linux / Windows ===
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# === GitHub Actions / CI ===
# No ignorar workflows pero sí artefactos locales
*.zip
*.tar.gz
*.tgz
*.bak

# === Python / Aux scripts (optional) ===
__pycache__/
*.pyc
*.pyo
*.pyd

# === LaTeX (report/) auxiliary outputs ===
# Keep main.tex and main.pdf; everything else is regeneratable from pdflatex.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.lof
report/*.lot
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# === Seguridad ===
# Llaves privadas y credenciales
*.pem
*.key
*.crt
*.cer
*.pfx
*.secret
*.json
!azurerm_provider_config.json.example
